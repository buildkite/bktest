*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

dist/
node_modules/
__pycache__/

internal/runner/testdata/jest/jest-result.json

internal/runner/testdata/rspec/rspec-result.json

internal/runner/testdata/cucumber/tmp/
internal/runner/testdata/cucumber/cucumber.json

.envrc

.direnv

# Local CLI binaries
/bktest
/bktec

internal/runner/testdata/*/tmp/

# Ignore env files for VScode debugging
.vscode/.env
